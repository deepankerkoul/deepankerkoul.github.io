---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search">
  <h1>Search</h1>
  <div id="search" class="mt-4"></div>

  <script>
    window.addEventListener('DOMContentLoaded', (event) => {
      // @ts-ignore
      new PagefindUI({ element: "#search", showSubResults: true });
    });
  </script>
</BaseLayout>
