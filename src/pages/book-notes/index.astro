---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('book-notes');
notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Book Notes">
  <h1>Book Notes</h1>
  
  <ul class="post-list">
    {notes.map(note => (
      <li>
        <a href={`/book-notes/${note.slug}`}>{note.data.title}</a>
        <span class="post-date">{note.data.date.toLocaleDateString()}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
